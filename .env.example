# Copy to .env and fill in values needed for local development.
# Google OAuth and AI keys are optional for basic local use; auth/AI features need them.

# === Core ===
HOST_URL=localhost
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION=86400

# Neo4j (defaults match the local Docker images)
NEO4J_URI=bolt://goals_db:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# === Frontend ===
REACT_APP_API_URL=http://localhost:5059/

# === Google OAuth (optional; required for Google sign-in / Calendar sync) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3030/auth/callback
REACT_APP_GOOGLE_CLIENT_ID=

# === AI suggestions (optional) ===
OPENROUTER_API_KEY=
GOALS_GEMINI_API_KEY=

# === Telegram notifications / monitoring (optional) ===
TELEGRAM_BOT_TOKEN=
GOALS_SERVER_TELEGRAM_CHAT_ID=

# === Production / tunnel (optional; not needed for local Docker Compose) ===
# GOALS_CLOUDFLARED_TOKEN=
# BACKUP_PATH=./backups
